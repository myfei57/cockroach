# LogicTest: !local-prepared

# Tests for the QUALIFY clause.

statement ok
CREATE TABLE events (
  account_id INT,
  created_at INT,
  amount INT,
  PRIMARY KEY (account_id, created_at)
)

statement ok
INSERT INTO events VALUES
  (1, 1, 10),
  (1, 2, 20),
  (1, 3, 30),
  (2, 4, 40),
  (2, 5, 50),
  (3, 6, 60)

# Basic QUALIFY using a SELECT alias of a window function.
query II
SELECT account_id, rn
FROM (
  SELECT account_id,
         row_number() OVER (PARTITION BY account_id ORDER BY created_at DESC) AS rn
  FROM events
)
WHERE rn = 1
ORDER BY account_id
----
1  1
2  1
3  1

# Same query written with QUALIFY. Only the account_id column is output; the
# hidden row_number window column must not leak into the result.
query I
SELECT account_id
FROM events
QUALIFY row_number() OVER (PARTITION BY account_id ORDER BY created_at DESC) = 1
ORDER BY account_id
----
1
2
3

# QUALIFY can reference the output alias of the window function.
query II
SELECT account_id, row_number() OVER (PARTITION BY account_id ORDER BY created_at) AS rn
FROM events
QUALIFY rn = 1
ORDER BY account_id
----
1  1
2  1
3  1

# QUALIFY runs before ORDER BY and LIMIT: the second row within each partition
# is filtered correctly and the outer ORDER BY still sorts the survivors.
query II
SELECT account_id, created_at
FROM events
QUALIFY rank() OVER (PARTITION BY account_id ORDER BY created_at) = 2
ORDER BY account_id
----
1  2
2  5

# FALSE and NULL QUALIFY conditions keep no rows.
query I
SELECT account_id FROM events QUALIFY FALSE
----

query I
SELECT account_id FROM events QUALIFY NULL
----

# QUALIFY interacts correctly with DISTINCT (filtering happens first).
query I
SELECT DISTINCT account_id
FROM events
QUALIFY dense_rank() OVER (PARTITION BY account_id ORDER BY amount) = 1
ORDER BY account_id
----
1
2
3

# QUALIFY with GROUP BY and an aggregate alias is evaluated after aggregation
# and window computation.
query II
SELECT account_id, c FROM (
  SELECT account_id,
         count(*) AS c,
         rank() OVER (ORDER BY count(*) DESC) AS r
  FROM events
  GROUP BY account_id
)
WHERE r = 1
ORDER BY account_id
----
1  3

# Same query using QUALIFY.
query II
SELECT account_id, count(*) AS c
FROM events
GROUP BY account_id
QUALIFY rank() OVER (ORDER BY count(*) DESC) = 1
ORDER BY account_id
----
1  3

# Aggregates are allowed directly in QUALIFY.
query I
SELECT account_id
FROM events
GROUP BY account_id
QUALIFY count(*) > 1
ORDER BY account_id
----
1
2

# QUALIFY combines with HAVING.
query I
SELECT account_id
FROM events
GROUP BY account_id
HAVING max(amount) > 40
QUALIFY count(*) = 2
ORDER BY account_id
----
2

# The QUALIFY condition must be boolean.
query error expected bool type, got int
SELECT account_id FROM events QUALIFY 1

statement error argument of ROW_NUMBER must not contain variables|window functions cannot be nested
SELECT account_id FROM events QUALIFY row_number() OVER (PARTITION BY row_number() OVER ()) = 1

# A bare name that is both an input column and a SELECT output alias is
# ambiguous.
query error column reference "account_id" is ambiguous
SELECT account_id FROM events QUALIFY account_id = 1

# A name that matches multiple SELECT aliases is ambiguous.
query error QUALIFY "x" is ambiguous
SELECT account_id AS x, created_at AS x FROM events QUALIFY x = 1

# A unique output alias that is not an input column can be used in QUALIFY.
query I
SELECT account_id + 0 AS aid FROM events QUALIFY aid = 2
ORDER BY aid
----
2

# QUALIFY is recognized inside subqueries and prepared statements.
query I rowsort
SELECT account_id FROM (
  SELECT account_id,
         row_number() OVER (PARTITION BY account_id ORDER BY created_at) AS rn
  FROM events
  QUALIFY rn = 1
)
----
1
2
3

# Queries without QUALIFY keep their behavior (plan/result unaffected).
query I
SELECT account_id FROM events WHERE created_at > 4 ORDER BY account_id
----
2
2
3
